{
  "name": "readfree",
  "version": "1.3.4",
  "description": "Clean, modern, glassmorphic Audible library backup and ABS organizer",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/**/*.test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --x64",
    "dist:portable": "electron-builder --win portable --x64"
  },
  "keywords": [
    "audible",
    "audiobook",
    "backup",
    "drm-free",
    "m4b",
    "audiobookshelf",
    "glassmorphism"
  ],
  "author": "ReadFree",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.readfree.app",
    "productName": "ReadFree",
    "copyright": "Copyright © 2026 ReadFree Contributors",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ReadFree",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
