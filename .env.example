# ReadFree Configuration Template
# All settings can also be configured directly via the application UI

# Audible Marketplace (us, uk, ca, de, au, fr)
AUDIBLE_MARKETPLACE=us

# Output root directory for Audiobookshelf organized files
# Default: User Music/Audiobooks
# AUDIBLE_OUTPUT_DIR=D:/Audiobooks

# Audiobookshelf Organization Settings
ENABLE_ABS_LAYOUT=true
ENABLE_ABS_METADATA=true
DOWNLOAD_COMPANION_PDFS=true
